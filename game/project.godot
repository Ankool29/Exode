; Projet Godot d'EXODE (moteur provisoire, cahier v0.4 decision 07 [P]).

config_version=5

[application]

config/name="EXODE"
config/description="Jeu d'automatisation industrielle - premiere version de developpement"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/low_processor_mode=false

[display]

window/size/viewport_width=540
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.1, 1)
